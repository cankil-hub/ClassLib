# Copy to .env only for explicit production management commands.
# Never commit credentials. Vercel must receive these as environment variables.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-project.vercel.app
# Vercel: Transaction pooler (6543); local migrate: Session pooler (5432).
# URL-encode reserved characters in the database password.
DATABASE_URL=
# Supabase > Storage > S3 connection: use S3 keys, NOT the REST API secret key.
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=classlib-files
